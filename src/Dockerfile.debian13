FROM debian:13-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev libjansson-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY powerkeyd.c sway-tablet-gestures.c ./

# Static jansson keeps the target free of a libjansson runtime dependency.
RUN gcc -O2 -march=x86-64-v2 -Wall -Wextra -o powerkeyd powerkeyd.c \
        -Wl,-Bstatic -ljansson -Wl,-Bdynamic \
 && gcc -O2 -march=x86-64-v2 -Wall -Wextra -o sway-tablet-gestures \
        sway-tablet-gestures.c \
        -Wl,-Bstatic -ljansson -Wl,-Bdynamic

CMD ["/bin/true"]
