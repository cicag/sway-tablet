FROM debian:13-slim

# Optional example toolchain image. src/build.sh bind-mounts the sources and
# the output directory, then compiles inside this container.

RUN apt-get update \
  && apt-get install -y --no-install-recommends gcc libc6-dev libjansson-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src
CMD ["/bin/true"]
