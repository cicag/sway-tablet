{
  "layer": "top",
  "exclusive": true,
  "position": "bottom",
  "height": 48,
  "modules-left": [
    "custom/launcher",
    "custom/ws1",
    "custom/ws2"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/keyboard",
    "custom/panel",
    "battery"
  ],
  "clock": {
    "format": "{:%a %H:%M}",
    "tooltip": false
  },
  "battery": {
    "format": "[{capacity}%]",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": false
  },
  "custom/launcher": {
    "format": "[{}]",
    "tooltip": false,
    "exec": "$HOME/.local/bin/waybar-app-state.sh org.swaytablet.appmenu Apps",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.local/bin/waybar-app-toggle.sh org.swaytablet.appmenu python3 $HOME/.local/bin/appmenu.py"
  },
  "custom/ws1": {
    "format": "[{}]",
    "exec": "$HOME/.local/bin/waybar-ws.sh 1",
    "return-type": "json",
    "interval": 1,
    "tooltip": false,
    "on-click": "swaymsg workspace 1"
  },
  "custom/ws2": {
    "format": "[{}]",
    "exec": "$HOME/.local/bin/waybar-ws.sh 2",
    "return-type": "json",
    "interval": 1,
    "tooltip": false,
    "on-click": "swaymsg workspace 2"
  },
  "custom/keyboard": {
    "format": "[{}]",
    "tooltip": false,
    "exec": "$HOME/.local/bin/waybar-kbd-state.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.local/bin/waybar-kbd.sh"
  },
  "custom/panel": {
    "format": "[{}]",
    "tooltip": false,
    "exec": "$HOME/.local/bin/waybar-app-state.sh org.swaytablet.controlpanel Set",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.local/bin/waybar-app-toggle.sh org.swaytablet.controlpanel $HOME/.local/bin/controlpanel"
  }
}
